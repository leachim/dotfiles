{
  // opencode global configuration
  // Docs: https://opencode.ai/docs/config
  //
  // Layout under $XDG_CONFIG_HOME/opencode (default ~/.config/opencode):
  //   opencode.jsonc  this file
  //   AGENTS.md       global instructions -> symlinked to ../claude/CLAUDE.md
  //   agent/*.md      custom agents
  //   command/*.md    custom slash commands
  //
  // Secrets (auth tokens) live in ~/.local/share/opencode/auth.json and are NOT tracked here.
  "$schema": "https://opencode.ai/config.json",

  // OpenRouter. The key itself is never stored here — it is read at startup
  // from $OR_OPENCODE_API_KEY, which belongs in ~/.secrets and is loaded into
  // the environment by the opencode() wrapper. Resolves to "" if unset, so
  // opencode still starts.
  "provider": {
    "openrouter": {
      "options": { "apiKey": "{env:OR_OPENCODE_API_KEY}" }
    }
  },
  "autoupdate": true,

  // Do not create shareable cloud links for sessions unless asked explicitly.
  "share": "disabled",

  // Mirrors the safety rules in claude/CLAUDE.md, which AGENTS.md points at.
  // Enforced by the tool rather than only asked for in the prompt.
  "permission": {
    "edit": "allow",
    "webfetch": "allow",

    // Credential files are not readable. grep gets the same list: searching a
    // file returns its contents just as reading it does.
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.secrets": "deny",
      "*.secrets.*": "deny",
      "*.secrets/*": "deny"
    },
    "grep": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.secrets": "deny",
      "*.secrets.*": "deny",
      "*.secrets/*": "deny"
    },
    "bash": {
      "*": "allow",

      // Destructive filesystem operations.
      "rm -r *": "ask",
      "rmdir *": "ask",

      // Irreversible GitHub operations.
      "gh pr close*": "ask",
      "gh pr merge*": "ask",
      "gh repo delete*": "deny",

      // SLURM job submission always needs explicit per-invocation approval.
      "srun *": "ask",

      // Privilege escalation and host control.
      "sudo *": "deny",
      "su *": "deny",
      "chown *": "deny",
      "shutdown *": "deny",
      "reboot *": "deny",
      "systemctl *": "deny",
      "service *": "deny"
    }
  }
}

# Taps
tap 'homebrew/bundle'

# CLI tools
brew 'awscli'
brew 'bash'
# cliclick is needed for close notification shortcut on mac
brew 'cliclick'
brew 'coreutils'
brew 'curl'
brew 'diff-pdf'
brew 'ffmpeg'
brew 'gawk'
brew 'gh'
brew 'git'
brew 'git-delta'
brew 'glow'
brew 'gmailctl'
brew 'grep'
brew 'htop'
brew 'imagemagick'
brew 'jq'
brew 'md5sha1sum'
brew 'neovim'
brew 'openjdk'
brew 'pdftk-java'
brew 'starship'
brew 'tmux'
brew 'tree'
brew 'wget'

# Apps (macOS only)
cask 'codexbar' if OS.mac?
cask 'fuse-t' if OS.mac?
cask 'dorso' if OS.mac?
cask 'qview' if OS.mac?
cask 'openlogi' if OS.mac?
cask 'posturr' if OS.mac?

# Spokenly is installed from the Mac App Store (MAS receipt, app.spokenly).
# Do NOT add 'cask spokenly' - the cask is a different, direct-download build
# and installing it would replace the MAS copy and its license entitlement.

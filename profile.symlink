# ~/.profile: executed by the command interpreter for login shells.
# This file is not read by bash(1), if ~/.bash_profile or ~/.bash_login exists.

# Deliberately unconditional, NOT guarded on DOTFILES_PROFILE_LOADED.
#
# macOS /etc/zprofile runs `path_helper`, which rebuilds PATH with /usr/bin and
# friends in front and everything else appended -- it demotes $HOME/.local/bin
# and /opt/bin behind the system paths. That happens in every login shell (zsh -l,
# a new terminal, tmux), so this prepend has to run each time to put them back.
# A guard would make the promotion happen exactly once per login chain and let a
# system binary shadow a uv/pipx tool in ~/.local/bin thereafter.
#
# Re-running it is safe: zsh dedupes via `typeset -U path PATH` (zshrc), and bash
# runs a dedupe pass at the end of ~/.bashrc.
export PATH="/opt/bin:$HOME/.local/bin:$HOME/.linuxbrew/bin:$HOME/.dotfiles/bin:$PATH"

export EDITOR='vim'
export VISUAL='vim'
export PAGER='less'
export LESS="-i -M -R -w -z-4"
export STARSHIP_CONFIG=~/.starship.toml
export DOTFILES_PROFILE_LOADED=1  # marker only; see the PATH note above

# Persistent socket directory instead of /tmp (survives cleanup on shared nodes),
# keyed on the cluster. clariden and daint share this NFS $HOME, so without the
# per-cluster subdir both head nodes would bind the same socket path and stomp on
# each other. CLUSTER_NAME is set by /etc/profile.d/cscs.sh; derive a fallback from
# the hostname (strip -lnNNN / -loginNNN) for hosts that don't set it.
: "${CLUSTER_NAME:=$(hostname -s 2>/dev/null | sed -E 's/-?[lL][nN]?[0-9]+$//; s/-login[0-9]*$//')}"
: "${CLUSTER_NAME:=default}"
export CLUSTER_NAME
export TMUX_TMPDIR="$HOME/.tmux_server/$CLUSTER_NAME"
mkdir -p "$TMUX_TMPDIR"

[ -f ~/.aliases ] && source ~/.aliases

[ -f ~/.gitaliases ] && source ~/.gitaliases

# per host configuration
if [ -f ~/.profile_hosts ]; then
    source ~/.profile_hosts
fi
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# Load NVM for non-interactive shells
export NVM_DIR="$HOME/.config/nvm"
if [ -s "$NVM_DIR/nvm.sh" ]; then
    \. "$NVM_DIR/nvm.sh" --no-use  # Load nvm but don't auto-use version
    nvm use default >/dev/null 2>&1 || true  # Use default version if set
fi


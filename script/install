#!/usr/bin/env bash
#
# Run dotfiles installers with prompts for optional components.

set -e

cd "$(dirname "$0")"/..
. script/lib.sh

# Prompt to run an installer
# Usage: run_optional "description" "path/to/install.sh"
run_optional () {
  local name=$1
  local script=$2

  if [ ! -f "$script" ]; then
    return
  fi

  user "Install ${name}? [y/N]"
  read -n 1 answer
  echo ''
  if [ "$answer" = "y" ] || [ "$answer" = "Y" ]; then
    info "installing ${name}"
    run_installer "$script"
    success "${name} installed"
  else
    success "skipped ${name}"
  fi
}

# Optional components
run_optional "Oh My Zsh"      ./zsh/install.sh
run_optional "Vim plugins"    ./vim/install.sh
run_optional "Tmux plugins (TPM)" ./tmux/install.sh
run_optional "Starship prompt" ./starship/install.sh
run_optional "Rust (rustup)"  ./rust/install.sh
run_optional "Bun"            ./bun/install.sh
run_optional "pixi"           ./pixi/install.sh
run_optional "chrome-headless-shell" ./chrome/install.sh
run_optional "Claude Code config" ./claude/install.sh
run_optional "Codex CLI config" ./codex/install.sh
# No sandbox, so not offered on macOS (their installers refuse there too)
if [ "$(uname -s)" != Darwin ]; then
  run_optional "opencode config" ./opencode/install.sh
  run_optional "pi coding agent" ./pi/install.sh
fi
run_optional "GitHub CLI (gh)" ./gh/install.sh

#!/usr/bin/env bash
#
# bootstrap installs things.

cd "$(dirname "$0")/.."
. script/lib.sh

set -e

echo ''

setup_gitconfig () {
  if ! [ -f git/gitconfig.local.symlink ]
  then
    info 'setup gitconfig'

    git_credential='cache'
    if [ "$(uname -s)" == "Darwin" ]
    then
      git_credential='osxkeychain'
    fi

    user ' - What is your github author name?'
    read -e git_authorname
    user ' - What is your github author email?'
    read -e git_authoremail

    sed -e "s/AUTHORNAME/$git_authorname/g" -e "s/AUTHOREMAIL/$git_authoremail/g" -e "s/GIT_CREDENTIAL_HELPER/$git_credential/g" git/gitconfig.local.symlink.example > git/gitconfig.local.symlink

    success 'gitconfig'
  fi
}


setup_pixi () {
  user ' - Do you want to install pixi? [y/N]'
  read -n 1 install_pixi
  echo ''
  if [ "$install_pixi" == "y" ] || [ "$install_pixi" == "Y" ]
  then
    info "installing pixi"
    if bash "$DOTFILES_ROOT/script/pixi-setup"
    then
      success "pixi installed"
    else
      fail "error installing pixi"
    fi
  else
    success "skipped pixi"
  fi
}

setup_host_role () {
  if ! [ -f "$DOTFILES_ROOT/host_role" ]
  then
    info 'setup host role'
    user ' - What role is this machine? [mac/linux-desktop/hpc]'
    read -e host_role
    if [ -n "$host_role" ] && [ -f "$DOTFILES_ROOT/hosts/${host_role}.sh" ]
    then
      echo "$host_role" > "$DOTFILES_ROOT/host_role"
      success "host role set to $host_role"
    else
      user " - No config found for '$host_role', skipping"
    fi
  fi
}

setup_localrc () {
  if ! [ -f localrc.symlink ]
  then
    info 'creating localrc from template'
    cp localrc.symlink.example localrc.symlink
    success 'localrc created — add machine-specific env vars to ~/.localrc'
  fi
}

setup_gitconfig
setup_localrc
setup_host_role
info 'installing dotfiles'
link_dotfiles

# If we're on a Mac, let's install and setup homebrew.
if [ "$(uname -s)" == "Darwin" ]
then
  info "installing dependencies"
  # Run in a subshell rather than `source`, and capture the exit status of dot
  # itself -- piping into `while read` made the status that of the loop, so the
  # failure branch below could never be reached.
  if bash bin/dot 2>&1 | while read -r data; do info "$data"; done; [ "${PIPESTATUS[0]}" -eq 0 ]
  then
    success "dependencies installed"
  else
    fail "error installing dependencies"
  fi
fi

# Optional: install pixi
if ! [ -d "$HOME/.pixi" ]
then
  setup_pixi
fi

# Optional tool installation (rust, starship, claude, oh-my-zsh, etc.)
info 'checking optional tools'
bash "$DOTFILES_ROOT/script/install"

echo ''
echo '  All installed!'

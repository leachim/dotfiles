#!/usr/bin/env bash
#
# Refresh symlinks after a pull. Idempotent, non-interactive, no package updates.
#
#   git pull && script/link

set -e
cd "$(dirname "$0")"/..
. script/lib.sh

info "refreshing *.symlink"
link_dotfiles

# Per-tool config linking. Each installer is idempotent and only links what the
# host already has; claude/install.sh also folds back a settings.json that was
# replaced by a regular file.
for installer in claude codex opencode; do
  script="$DOTFILES_ROOT/$installer/install.sh"
  [ -f "$script" ] || continue
  info "$installer config"
  run_installer "$script"
done

success "symlinks up to date"

# Machine-specific, non-secret environment variables.
# Copy to localrc.symlink; script/bootstrap symlinks it to ~/.localrc.
#
# Sourced by bash and zsh, inherited by every child process. Keep credentials
# out of here -- they go in ~/.secrets/<service> (dir 700, files 600, one file
# per service) and are loaded on demand:
#
#   secrets                     every service, into your interactive shell
#   secrets openrouter          just that one
#   claude-op / opencode /      each names the services its tool needs, in a
#   gemini-api                    subshell
#   bin/push                    reads ~/.secrets/pushover directly

# The one exception is PUSHOVER_ALERTS below: it is a credential, but it lives
# here because the tools that must send alerts cannot read ~/.secrets.

# --- Pushover ---
# Delivery GROUP key for bin/push-alert -- it decides who receives an alert and
# goes in Pushover's `user=` field, not `token=` (the app token stays in
# ~/.secrets/pushover, which bin/push reads on its own). Treat it as a secret:
# pass it by name, never echo it into a log, a commit or a job script.
# export PUSHOVER_ALERTS=""

# --- GitHub ---
# org/repo for default gh operations. The token is stored by `gh auth login`;
# an exported GH_TOKEN overrides that, so leave it unset.
# export GH_USER=""

# --- AWS ---
# ECR registry account id, used by aws-login.
# export AWS_ACCOUNT=""

# --- Claude Code ---
export CLAUDE_CODE_NO_FLICKER=1

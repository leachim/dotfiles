{
  "env": {},
  "permissions": {
    "allow": [
      "Bash(awk:*)",
      "Bash(cat:*)",
      "Bash(cd:*)",
      "Bash(cp:*)",
      "Bash(curl:*)",
      "Bash(diff:*)",
      "Bash(echo:*)",
      "Bash(file:*)",
      "Bash(find:*)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(grep:*)",
      "Bash(gunzip:*)",
      "Bash(gzip:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(man:*)",
      "Bash(mkdir:*)",
      "Bash(pwd:*)",
      "Bash(sbatch:*)",
      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(srun:*)",
      "Bash(tail:*)",
      "Bash(tar:*)",
      "Bash(test:*)",
      "Bash(timeout:*)",
      "Bash(touch:*)",
      "Bash(tree:*)",
      "Bash(uniq:*)",
      "Bash(unzip:*)",
      "Bash(wc:*)",
      "Bash(wget:*)",
      "Bash(whereis:*)",
      "Bash(which:*)",
      "MCP(context7:*)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "deny": [
      "Bash(gh repo delete:*)",
      "Bash(reboot:*)",
      "Bash(service:*)",
      "Bash(shutdown:*)",
      "Bash(su:*)",
      "Bash(sudo:*)",
      "Bash(systemctl:*)",
      "Read(~/**/.secrets)",
      "Read(~/**/.secrets.*)",
      "Read(~/**/.secrets/**)",
      "Read(~/**/*.secrets)",
      "Read(~/.secrets)",
      "Read(~/.secrets.*)",
      "Read(~/.secrets/**)"
    ],
    "ask": [
      "Bash(gh pr close:*)",
      "Bash(gh pr merge:*)",
      "Bash(rm -r:*)",
      "Bash(rmdir:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.dotfiles/bin/claude-notify --min-seconds 60 \"Task completed\"",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.dotfiles/bin/claude-notify \"Awaiting your input\"",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.dotfiles/bin/claude-notify --mark"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.dotfiles/bin/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "code-review": false,
    "codex@openai-codex": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  },
  "pluginConfigs": {},
  "autoUpdatesChannel": "latest",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(sbatch:*) in /users/mschneider/niobe — SLURM job submission is flagged explicitly in ~/.claude/CLAUDE.md as requiring prior approval; treat as soft block pending explicit written confirmation",
      "Bash(scancel:*) in /users/mschneider/niobe — cancels shared-cluster jobs; frequent in history (35×) but destructive to running work without confirmation"
    ],
    "environment": []
  }
}

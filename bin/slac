#!/bin/bash
# Send notifications via Slack Bot API (ephemeral messages)
#
# SLACK_BOT_TOKEN, SLACK_CHANNEL and SLACK_USER_ID are read from
# ~/.secrets/slack at call time; override the location with SLACK_CREDENTIALS.
# Pre-set env vars win.

SLACK_CREDENTIALS="${SLACK_CREDENTIALS:-$HOME/.secrets/slack}"

if [ -z "$SLACK_BOT_TOKEN" ] || [ -z "$SLACK_CHANNEL" ] || [ -z "$SLACK_USER_ID" ]; then
    if [ -r "$SLACK_CREDENTIALS" ]; then
        _token=$SLACK_BOT_TOKEN _channel=$SLACK_CHANNEL _user=$SLACK_USER_ID
        . "$SLACK_CREDENTIALS"
        SLACK_BOT_TOKEN=${_token:-$SLACK_BOT_TOKEN}
        SLACK_CHANNEL=${_channel:-$SLACK_CHANNEL}
        SLACK_USER_ID=${_user:-$SLACK_USER_ID}
    fi
fi

if [ -z "$SLACK_BOT_TOKEN" ] || [ -z "$SLACK_CHANNEL" ] || [ -z "$SLACK_USER_ID" ]; then
    echo "Error: SLACK_BOT_TOKEN, SLACK_CHANNEL and SLACK_USER_ID must be set (looked in $SLACK_CREDENTIALS)" >&2
    exit 1
fi

usage() {
    echo "Usage: slac [exit_status] [runtime_secs] [message]"
    echo "       slac [message]"
    echo ""
    echo "Examples:"
    echo "  slac 0 120              # success after 2min"
    echo "  slac 1 60 'build broke' # failure after 1min with message"
    echo "  slac 'deploy finished'  # plain message"
    exit 1
}

[[ "$1" == "-h" || "$1" == "--help" ]] && usage

# Parse arguments: single arg can be exit status (integer) or message (string)
if [ $# -eq 1 ]; then
    if [[ "$1" =~ ^[0-9]+$ ]]; then
        EXIT_STATUS="$1"
        RUNTIME=""
        CUSTOM_MESSAGE=""
    else
        EXIT_STATUS=""
        RUNTIME=""
        CUSTOM_MESSAGE="$1"
    fi
else
    EXIT_STATUS="${1:-""}"
    RUNTIME="${2:-""}"
    CUSTOM_MESSAGE="${3:-""}"
fi

_HOST=$(hostname)
case "$_HOST" in
    eu-*) _GROUP="Euler" ;;
    bs-*) _GROUP="BSSE" ;;
    *)    _GROUP="" ;;
esac
LOCATION="${_GROUP:+[$_GROUP] }[$_HOST:$(pwd)]"

if [ -n "$EXIT_STATUS" ]; then
    STATUS_TEXT=$( [ "$EXIT_STATUS" -eq 0 ] && echo "ok" || echo "FAILED (exit $EXIT_STATUS)" )
    if [ -n "$RUNTIME" ]; then
        HOURS=$((RUNTIME / 3600))
        MINS=$(((RUNTIME % 3600) / 60))
        SECS=$((RUNTIME % 60))
        STATUS_TEXT="$STATUS_TEXT ($(printf "%02d:%02d:%02d" $HOURS $MINS $SECS))"
    fi
else
    STATUS_TEXT="notification"
fi

if [ -n "$CUSTOM_MESSAGE" ]; then
    FULL_MESSAGE="$CUSTOM_MESSAGE - $LOCATION $STATUS_TEXT"
else
    FULL_MESSAGE="$LOCATION $STATUS_TEXT"
fi

# Form-encoded rather than hand-built JSON, so quotes and newlines in the
# message need no escaping.
RESPONSE=$(curl -s -X POST "https://slack.com/api/chat.postEphemeral" \
  -H "Authorization: Bearer $SLACK_BOT_TOKEN" \
  --data-urlencode "channel=$SLACK_CHANNEL" \
  --data-urlencode "user=$SLACK_USER_ID" \
  --data-urlencode "text=$FULL_MESSAGE")

if echo "$RESPONSE" | grep -q '"ok":true'; then
    echo "sent"
else
    echo "failed: $RESPONSE" >&2
    exit 1
fi

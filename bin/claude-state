#!/bin/bash
# Track whether a Claude Code session is busy, so the statusline can show it.
# Driven by hooks (see claude/settings.json):
#
#   claude-state run    UserPromptSubmit                  turn started
#   claude-state resume PostToolUse, PostToolUseFailure   back to run if it was ask
#   claude-state ask    PreToolUse AskUserQuestion|ExitPlanMode
#   claude-state notify Notification                      ask or idle, by notification_type
#   claude-state idle   Stop, StopFailure                 turn over: wait if a background
#                                                         shell/Monitor or session cron
#                                                         is pending, else done
#   claude-state end    SessionEnd                        drop the state file
#   claude-state focus %PANE SOCKET  tmux pane-focus-in       you looked: clear done
#
# Output: $STATE_DIR/<session_id> holding "<state> <since epoch> [label]", which
# statusline.sh turns into a full-width coloured bar under the prompt.
# States: run (turn in progress), wait (turn over, but a background shell,
# Monitor or scheduled wakeup will resume it), ask (blocked on a prompt), done (finished,
# your move; cleared by the next prompt or by focusing its tmux pane, so if you
# are on the pane already it stays until you leave and come back), idle
# (fresh or Esc-interrupted).
#
# Esc-interrupting a turn fires no Stop hook, so the state stays "run" until the
# next prompt or the idle_prompt notification (~60s later) resets it.
#
# STATE_DIR lives in $HOME, not XDG_RUNTIME_DIR: Claude often runs inside
# `srun --pty` on a compute node while the tmux server (and its focus hook) runs
# on the login node, and only the home filesystem is visible to both.
# Keep in sync with statusline.sh.

STATE_DIR="$HOME/.cache/claude-state"

MODE="${1:-}"

INPUT=""
[ -t 0 ] || INPUT=$(cat)

# jq is not on every host (CSCS login nodes); sed works on the flat fields we need.
json_str() {
    printf '%s' "$INPUT" | tr -d '\n' |
        sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1
}

# tmux pane -> session map, so the pane-focus-in hook can find the session.
# Keyed by tmux socket too: pane ids repeat across servers (one per login node).
pane_map() {
    local p="${1#%}" k
    k=$(printf '%s' "$2" | cksum | cut -d' ' -f1)
    printf '%s/pane-%s-%s' "$STATE_DIR" "$k" "${p//[^0-9]/}"
}

if [ "$MODE" = focus ]; then
    read -r SESSION 2>/dev/null < "$(pane_map "${2:-}" "${3:-}")" || exit 0
else
    SESSION=$(json_str session_id)
fi
SESSION="${SESSION//[^A-Za-z0-9_-]/}"
[ -n "$SESSION" ] || exit 0
FILE="$STATE_DIR/$SESSION"

read -r CUR START _ 2>/dev/null < "$FILE"
LABEL=""

# Turn ended: is a watched job still going to wake this session? Counts
# background shells, Monitors and scheduled wakeups (session_crons); background
# subagents and workflows do not count. Prints a label and succeeds if so.
pending_label() {
    # Decide and summarise in python3 (jq is missing on CSCS login nodes).
    if command -v python3 >/dev/null 2>&1; then
        printf '%s' "$INPUT" | python3 -I -c '
import json, sys
d = json.load(sys.stdin)
tasks = [t for t in d.get("background_tasks") or [] if t.get("type") in ("shell", "monitor")]
crons = d.get("session_crons") or []
if not tasks and not crons:
    sys.exit(1)
parts = []
if tasks:
    desc = " ".join((tasks[0].get("description") or tasks[0].get("type")).split())
    parts.append(desc[:60] + ("..." if len(desc) > 60 else ""))
    if len(tasks) > 1:
        parts.append("+%d more" % (len(tasks) - 1))
if crons:
    parts.append("%d wakeup%s" % (len(crons), "s" if len(crons) > 1 else ""))
print(", ".join(parts))
' 2>/dev/null
        return
    fi
    # No python3: match the flat JSON.
    case "$(printf '%s' "$INPUT" | tr -d ' \n\t')" in
        *'"type":"shell"'*|*'"type":"monitor"'*|*'"session_crons":[{'*) echo "background job" ;;
        *) return 1 ;;
    esac
}

case "$MODE" in
    run)    NEW=run; START=$(date +%s) ;;
    resume) [ "$CUR" = ask ] || exit 0; NEW=run ;;
    ask)    NEW=ask ;;
    notify)
        case "$(json_str notification_type)" in
            permission_prompt|elicitation_dialog) NEW=ask ;;
            # Only clears a stale run (Esc-interrupt fires no Stop); a session
            # waiting on background work also sits at an idle prompt.
            idle_prompt) [ "$CUR" = run ] || exit 0; NEW=idle ;;
            *)                                    exit 0 ;;
        esac ;;
    idle)
        if [ "$(json_str hook_event_name)" = Stop ] && LABEL=$(pending_label); then
            NEW=wait
            [ "$CUR" = wait ] || START=$(date +%s)
        else
            NEW=done; START=$(date +%s)
        fi ;;
    end) NEW=idle ;;
    focus) [ "$CUR" = done ] || exit 0; NEW=idle ;;
    *) echo "usage: claude-state run|resume|ask|notify|idle|end|focus" >&2; exit 2 ;;
esac

# A notification that arrives after the turn ended must not resurrect it.
case "$NEW:${CUR:-idle}" in ask:idle|ask:done) exit 0 ;; esac
[ "$NEW" = "$CUR" ] && [ "$NEW" != wait ] && [ "$MODE" != end ] && exit 0

mkdir -p "$STATE_DIR" 2>/dev/null && chmod 700 "$STATE_DIR" 2>/dev/null
if [ -n "$TMUX_PANE" ] && [ "$MODE" != focus ]; then
    printf '%s\n' "$SESSION" > "$(pane_map "$TMUX_PANE" "${TMUX%%,*}")"
fi
if [ "$MODE" = end ]; then
    rm -f "$FILE"
    [ -n "$TMUX_PANE" ] && rm -f "$(pane_map "$TMUX_PANE" "${TMUX%%,*}")"
    find "$STATE_DIR" -maxdepth 1 -type f -mtime +2 -delete 2>/dev/null
else
    printf '%s %s %s\n' "$NEW" "${START:-$(date +%s)}" "$LABEL" > "$FILE"
fi

exit 0

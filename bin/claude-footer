#!/bin/bash
#
# Path, git branch and session name for the end of Claude Code's footer row,
# printed by the footer-git mod (claude/mods/footer-git):
# "~/.dotfiles main · darwin-test".
#
#   claude-footer <dir> [session-id]
#
# The session name comes from the file bin/statusline.sh keeps, as the status
# line is the only place Claude Code hands it out.

CWD=${1:-$PWD}
ID=${2//[^A-Za-z0-9_-]/}

SHOWN=$CWD
case "$SHOWN" in "$HOME"|"$HOME"/*) SHOWN="~${SHOWN#"$HOME"}" ;; esac
[ "${#SHOWN}" -gt 20 ] && SHOWN="…/$(basename "$CWD")"
OUT=$SHOWN

# Reads HEAD only, no work-tree scan, so it costs the same on any repo size.
BRANCH=$(git -C "$CWD" symbolic-ref --short -q HEAD 2>/dev/null \
  || git -C "$CWD" rev-parse --short HEAD 2>/dev/null)
[ -n "$BRANCH" ] && OUT="$OUT $BRANCH"

NAME=""
[ -n "$ID" ] && read -r NAME 2>/dev/null < "$HOME/.cache/claude-state/$ID.name"
[ "${#NAME}" -gt 18 ] && NAME="${NAME:0:17}…"
[ -n "$NAME" ] && OUT="$OUT · $NAME"

printf '%s\n' "$OUT"

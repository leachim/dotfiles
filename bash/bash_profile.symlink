## Load profile and bashrc for bash login sessions (e.g. via ssh)

# bs-* Linux hosts (see hosts/hostnames/bs.sh): /etc/profile has already made
# TMOUT=1800 readonly, which this shell cannot undo. Replace it with a non-login
# shell started without TMOUT, which claims TMOUT=0 itself. Done first so the
# rest of the chain runs only once, in the new shell (it gets PATH, cargo and bun
# from ~/.bashrc/~/.profile). Only for interactive terminal sessions, not
# `bash -lc cmd` or scp. The non-login shell never reads this file, so no loop.
case "$HOSTNAME" in
    bs*)
        if [[ $- == *i* ]] && [ -t 0 ] && [ -z "$BASH_EXECUTION_STRING" ] \
            && [ "${TMOUT:-0}" != 0 ] && readonly -p | grep -q ' TMOUT='; then
            exec env -u TMOUT "$BASH"
        fi ;;
esac

# ~/.bashrc sources ~/.profile itself, so sourcing it covers both. Skip it when
# /etc/profile already did (SUSE does for login shells) -- otherwise every SSH
# login runs .profile 3x and .bashrc 2x.
if [ -z "${__DOTFILES_BASHRC_SOURCED:-}" ] && [ -f ~/.bashrc ]; then
    source ~/.bashrc
fi
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

